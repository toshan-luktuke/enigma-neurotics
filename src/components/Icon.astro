---
import arrowDown from '@phosphor-icons/core/assets/regular/arrow-down.svg?raw';
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import asterisk from '@phosphor-icons/core/assets/regular/asterisk-simple.svg?raw';
import atom from '@phosphor-icons/core/assets/regular/atom.svg?raw';
import binoculars from '@phosphor-icons/core/assets/regular/binoculars.svg?raw';
import book from '@phosphor-icons/core/assets/regular/book-open.svg?raw';
import books from '@phosphor-icons/core/assets/regular/books.svg?raw';
import clock from '@phosphor-icons/core/assets/regular/clock.svg?raw';
import cpu from '@phosphor-icons/core/assets/regular/cpu.svg?raw';
import share from '@phosphor-icons/core/assets/regular/export.svg?raw';
import hourglass from '@phosphor-icons/core/assets/regular/hourglass.svg?raw';
import search from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import moon from '@phosphor-icons/core/assets/regular/moon-stars.svg?raw';
import plant from '@phosphor-icons/core/assets/regular/plant.svg?raw';
import rss from '@phosphor-icons/core/assets/regular/rss.svg?raw';
import sparkle from '@phosphor-icons/core/assets/regular/sparkle.svg?raw';
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
const icons: Record<string, string> = {
  'arrow-down': arrowDown,
  'arrow-right': arrowRight,
  'arrow-up-right': arrowUpRight,
  'asterisk-simple': asterisk,
  atom,
  binoculars,
  'book-open': book,
  books,
  clock,
  cpu,
  export: share,
  hourglass,
  'magnifying-glass': search,
  'moon-stars': moon,
  plant,
  rss,
  sparkle,
};
---

<span class:list={['ph', `ph-${name}`, className]} aria-hidden="true" set:html={icons[name]} />
