---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from './SiteLayout.astro';
import EditionMeta from '../components/EditionMeta.astro';
import ShareButton from '../components/ShareButton.astro';
import SourceList from '../components/SourceList.astro';
import ArchiveEntry from '../components/ArchiveEntry.astro';
import Icon from '../components/Icon.astro';
import { formatDate, publicationDate } from '../lib/publication';
interface Props {
  entry: CollectionEntry<'discoveries'>;
  previous: CollectionEntry<'discoveries'>[];
  home?: boolean;
}
const { entry, previous, home = false } = Astro.props;
const { Content, headings } = await render(entry);
const isToday = entry.data.date === publicationDate();
const articleUrl = new URL(`/discoveries/${entry.data.slug}/`, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: `${entry.data.date}T06:15:00+05:30`,
  mainEntityOfPage: articleUrl,
  publisher: { '@type': 'Organization', name: 'TIL' },
  ...(entry.data.image ? { image: new URL(entry.data.image.src, Astro.site).href } : {}),
};
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.summary}
  image={entry.data.image?.src}
  article
  date={entry.data.date}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')}
  />
  <div class="edition-topline shell">
    <span>
      <span class="edition-dot"></span>
      {home && isToday ? "TODAY'S DISCOVERY" : home ? 'LATEST DISCOVERY' : 'FROM THE ARCHIVE'}
    </span>
    <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
  </div>
  <article class="daily-edition">
    <header class="story-header shell">
      <div class="story-title-group">
        <EditionMeta entry={entry} />
        <h1>{entry.data.title}</h1>
        <p class="story-deck">{entry.data.summary}</p>
        <a class="read-link" href={`#${headings[0]?.slug || 'story'}`}>
          Read the story <Icon name="arrow-down" />
        </a>
      </div>
      <div class="edition-note">
        <span class="note-line"></span>
        <p>
          A small discovery.
          <br />A different way to
          <br />
          see your day.
        </p>
        <Icon name="asterisk-simple" />
      </div>
    </header>
    {entry.data.image && (
      <figure class="story-image shell">
        <Image
          src={entry.data.image}
          alt={entry.data.imageAlt!}
          widths={[480, 800, 1200, 1800]}
          sizes="(max-width: 700px) 100vw, 90vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <span>Look a little closer.</span>
          {entry.data.imageCredit && (
            <a href={entry.data.imageCreditUrl}>{entry.data.imageCredit}</a>
          )}
        </figcaption>
      </figure>
    )}
    <div class="reading-grid shell" id="story">
      <aside class="reading-aside">
        <span class="eyebrow">IN THIS DISCOVERY</span>
        <nav aria-label="Article sections">
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
        </nav>
        <span class="aside-footnote">A few minutes well spent.</span>
      </aside>
      <div class="reading-column">
        <div class="prose">
          <Content />
        </div>
        <div class="story-end">
          <span>Now you know.</span>
          <ShareButton title={entry.data.title} url={articleUrl} />
        </div>
        <SourceList sources={entry.data.sources} />
      </div>
    </div>
  </article>
  {previous.length > 0 && (
    <section class="previous-section shell" aria-labelledby="previous-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">THERE'S MORE WHERE THAT CAME FROM</span>
          <h2 id="previous-heading">Previously on til.</h2>
        </div>
        <a class="text-link" href="/archive/">
          The whole archive <Icon name="arrow-up-right" />
        </a>
      </div>
      <div class="previous-entries">
        {previous.slice(0, 3).map((item) => (
          <ArchiveEntry entry={item} />
        ))}
      </div>
    </section>
  )}
  <section class="closing-note shell">
    <Icon name="sparkle" />
    <h2>
      The world is full of things
      <br />
      you haven't noticed yet.
    </h2>
    <p>One new discovery. Every day. See you tomorrow.</p>
    <a href="/archive/" class="text-link">
      Find something else to wonder about <Icon name="arrow-right" />
    </a>
  </section>
</SiteLayout>
